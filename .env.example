# Copy to .env (git-ignored) and fill in. Never commit real values.

# PostgreSQL (asyncpg driver). Tests use XSCOUT_TEST_DATABASE_URL and refuse
# to run unless the database name is xscout_test.
XSCOUT_DATABASE_URL=postgresql+asyncpg://xscout:<password>@localhost:5432/xscout
XSCOUT_TEST_DATABASE_URL=postgresql+asyncpg://xscout:<password>@localhost:5432/xscout_test

# Fernet key for cookie encryption. Generate with: uv run xscout keygen
# Losing this key means every account has to be added again.
XSCOUT_SECRET_KEY=

# Optional overrides
# XSCOUT_HOST=127.0.0.1
# XSCOUT_PORT=8790
# XSCOUT_CONFIG_FILE=config/xscout.yaml
# XSCOUT_LOG_LEVEL=INFO
